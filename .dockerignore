# What the PHP and web images are built from is web/ and docker/. Everything else, and
# everything that is generated or private, stays out of the build context.
.git
.github
.claude
.gitignore
.gitattributes
.editorconfig
README.md
docs
e2e
tests
ml

**/node_modules
**/.DS_Store
**/*.log

web/vendor
web/tests
web/.env
web/.env.*
!web/.env.example
web/public/build
web/public/hot
web/public/storage
web/storage/logs/*
web/storage/framework/cache/*
web/storage/framework/sessions/*
web/storage/framework/views/*
web/storage/app/*
web/storage/inertia-devtools
web/bootstrap/cache/*
!web/bootstrap/cache/.gitignore
web/resources/js/routes
web/resources/js/actions
web/resources/js/wayfinder
web/.phpunit.cache
web/coverage
