# Root compose variables (optional - defaults are fine for local dev).
# Laravel's own settings live in web/.env (created automatically from web/.env.example).

# Shared secret between Laravel and the ML service. Change outside local dev.
ML_INTERNAL_TOKEN=change-me-dev-token

# Match your host user so bind-mounted files stay writable (Linux/macOS: `id -u` / `id -g`).
UID=1000
GID=1000
