# StockSense AI - production settings for compose.prod.yaml.
#
#   cp .env.production.example .env
#
# Fill in every value marked REQUIRED. Nothing here has a safe default for production, and the
# stack will not start without them. Generate random values with:  openssl rand -hex 24
# Never commit the filled-in file (.env is ignored by git). See docs/deployment.md.

# --- The site -------------------------------------------------------------------------------
# REQUIRED. The address people will type. Use https:// (see TRUSTED_PROXIES below).
APP_URL=https://stock.example.com
APP_NAME="StockSense AI"
APP_TIMEZONE=Asia/Manila

# REQUIRED. Generate with:   echo "base64:$(openssl rand -base64 32)"
# It signs sessions and encrypts cookies. Losing it signs everyone out; changing it later does too.
APP_KEY=

# The port the web server listens on, on this machine. A reverse proxy that ends HTTPS forwards to it.
HTTP_PORT=80

# When a reverse proxy or load balancer sits in front: the proxy's address(es), comma separated,
# or "*" to trust any (only when the app can be reached through the proxy alone). It lets the app
# see the real visitor address and know the request was HTTPS.
TRUSTED_PROXIES=

# Send session cookies over HTTPS only. Leave true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=true

# --- Secrets (REQUIRED) ---------------------------------------------------------------------
# Long random values, all different. The stack refuses to start with the development ones.
DB_PASSWORD=
REDIS_PASSWORD=
# Shared by the app and the forecasting service. At least 24 characters.
ML_INTERNAL_TOKEN=

# --- Email (REQUIRED) -----------------------------------------------------------------------
# Set-up links, alerts and digests go out through this SMTP service. Emails never contain
# personal data (see README).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# "smtp" for STARTTLS on 587 (or none), "smtps" for implicit TLS on 465; "null" lets the app decide.
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# --- Optional -------------------------------------------------------------------------------
LOG_LEVEL=info
# Switch the automatic forecast and advice schedules off here (the Owner can also do it under
# System settings).
FORECAST_SCHEDULE=true
REPLENISHMENT_SCHEDULE=true
