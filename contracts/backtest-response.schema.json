{
  "$defs": {
    "BaselineMetrics": {
      "properties": {
        "seasonal_naive": {
          "$ref": "#/$defs/Metrics",
          "description": "Same period last year."
        },
        "moving_average": {
          "$ref": "#/$defs/Metrics",
          "description": "Average of the last few periods."
        }
      },
      "required": [
        "seasonal_naive",
        "moving_average"
      ],
      "title": "BaselineMetrics",
      "type": "object"
    },
    "CategoryMetrics": {
      "properties": {
        "model": {
          "$ref": "#/$defs/Metrics"
        },
        "seasonal_naive": {
          "$ref": "#/$defs/Metrics"
        },
        "moving_average": {
          "$ref": "#/$defs/Metrics"
        }
      },
      "required": [
        "model",
        "seasonal_naive",
        "moving_average"
      ],
      "title": "CategoryMetrics",
      "type": "object"
    },
    "FeatureImportance": {
      "properties": {
        "feature": {
          "title": "Feature",
          "type": "string"
        },
        "importance": {
          "description": "Share of the model's total gain; all features sum to 1.",
          "title": "Importance",
          "type": "number"
        }
      },
      "required": [
        "feature",
        "importance"
      ],
      "title": "FeatureImportance",
      "type": "object"
    },
    "FoldResult": {
      "properties": {
        "origin": {
          "description": "Start of the last period the model was allowed to see.",
          "format": "date",
          "title": "Origin",
          "type": "string"
        },
        "test_start": {
          "format": "date",
          "title": "Test Start",
          "type": "string"
        },
        "test_end": {
          "description": "Start of the last period tested.",
          "format": "date",
          "title": "Test End",
          "type": "string"
        },
        "n_series": {
          "title": "N Series",
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "baseline_metrics": {
          "$ref": "#/$defs/BaselineMetrics"
        }
      },
      "required": [
        "origin",
        "test_start",
        "test_end",
        "n_series",
        "metrics",
        "baseline_metrics"
      ],
      "title": "FoldResult",
      "type": "object"
    },
    "Granularity": {
      "enum": [
        "week",
        "month"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "Metrics": {
      "properties": {
        "mae": {
          "description": "Mean absolute error, in units.",
          "title": "Mae",
          "type": "number"
        },
        "rmse": {
          "description": "Root mean squared error, in units.",
          "title": "Rmse",
          "type": "number"
        },
        "mape": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mean absolute percentage error over periods that had sales; null if none did.",
          "title": "Mape"
        },
        "wape": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total absolute error as a percentage of total units sold; null if none were sold.",
          "title": "Wape"
        },
        "n": {
          "description": "Product-periods compared.",
          "title": "N",
          "type": "integer"
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Percentage of actual values inside the forecast interval (the target is 80). Null for forecasts without an interval.",
          "title": "Coverage"
        }
      },
      "required": [
        "mae",
        "rmse",
        "mape",
        "wape",
        "n"
      ],
      "title": "Metrics",
      "type": "object"
    }
  },
  "properties": {
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "granularity": {
      "$ref": "#/$defs/Granularity"
    },
    "horizon": {
      "title": "Horizon",
      "type": "integer"
    },
    "folds": {
      "items": {
        "$ref": "#/$defs/FoldResult"
      },
      "title": "Folds",
      "type": "array"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Metrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineMetrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "per_category_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/CategoryMetrics"
      },
      "title": "Per Category Metrics",
      "type": "object"
    },
    "residual_std": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Residual Std",
      "type": "object"
    },
    "feature_importance": {
      "items": {
        "$ref": "#/$defs/FeatureImportance"
      },
      "title": "Feature Importance",
      "type": "array"
    }
  },
  "required": [
    "model_version",
    "granularity",
    "horizon",
    "folds",
    "metrics",
    "baseline_metrics",
    "per_category_metrics",
    "residual_std",
    "feature_importance"
  ],
  "title": "BacktestResponse",
  "type": "object"
}
