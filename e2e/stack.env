# Settings for the throwaway production-like stack the end-to-end tests run against
# (see e2e/README.md). These are test values for a stack that is created and destroyed on one
# machine: they protect nothing, and must never be used anywhere real.
APP_URL=http://localhost:8090
HTTP_PORT=8090
APP_KEY=base64:ZTJlLW9ubHktTk9ULWEtc2VjcmV0LTAxMjM0NTY3ODk=
DB_PASSWORD=e2e-only-db-password-0123456789
REDIS_PASSWORD=e2e-only-redis-password-0123456789
ML_INTERNAL_TOKEN=e2e-only-ml-token-0123456789abcdef
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@stocksense.test
SESSION_SECURE_COOKIE=false
LOG_LEVEL=warning
